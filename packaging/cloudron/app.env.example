# Cloudron-Isoflow runtime configuration.
#
# This file lives at /app/data/app.env on the Cloudron host. It is created
# from this example on first boot if it does not exist. Edit it via the
# Cloudron Web Terminal or File Manager and restart the app to apply.
#
# Default behavior is PUBLIC (no authentication). Set AUTH_ENABLED=true to
# require any authenticated Cloudron user before the app loads.

# Enable Cloudron single sign-on (OIDC). Accepts: true | false. Default: false.
AUTH_ENABLED=false

# Session cookie secret. Auto-generated on first boot if left blank. Treat
# as sensitive; rotating it logs out all current sessions.
SESSION_SECRET=

# Optional: comma-separated list of Cloudron usernames allowed when
# AUTH_ENABLED=true. Empty means "any authenticated user".
ALLOWED_USERS=
